{
  "name": "iris",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "sidecar"
  ],
  "scripts": {
    "dev": "concurrently -n sidecar,tauri -c yellow,cyan \"npm run dev -w sidecar\" \"npm run tauri dev\"",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build -w sidecar && tauri build",
    "build:web": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "concurrently": "^9.1.0",
    "vite": "^8.0.16",
    "typescript": "~6.0.3"
  }
}
